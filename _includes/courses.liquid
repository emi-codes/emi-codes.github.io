{% assign sections = "course,workshop,thesis" | split: "," %}

{% for section in sections %}
  {% case section %}
    {% when "course" %}
      {% assign heading = "Courses and Seminars" %}
    {% when "workshop" %}
      {% assign heading = "Workshops" %}
    {% when "thesis" %}
      {% assign heading = "Theses" %}
  {% endcase %}

  {% assign section_entries = site.teachings | where: "type", section %}

  {% if section_entries.size > 0 %}
    <h2>{{ heading }}</h2>

    {% assign entries_by_year = section_entries | group_by: "year" | sort: "name" | reverse %}

    {% for year_group in entries_by_year %}
      <h3 class="year">{{ year_group.name }}</h3>

      <ul>
        {% assign year_entries = year_group.items | sort: "title" %}
        {% for entry in year_entries %}
          <li>
            <strong>{{ entry.title }}</strong>
            {% if entry.term %} — {{ entry.term }}{% endif %}
            {% if entry.description %}
              <div>{{ entry.description | markdownify }}</div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endfor %}
  {% endif %}
{% endfor %}