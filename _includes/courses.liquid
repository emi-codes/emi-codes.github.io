{% if site.teachings %}
  <div class="teaching-list">
    {% assign entries_by_year = site.teachings | sort: 'year' | reverse | group_by: 'year' %}

    {% for year_group in entries_by_year %}
      <h2 class="year">{{ year_group.name }}</h2>
      <div class="course-list">
        {% assign entries = year_group.items | sort: 'term' %}

        {% for entry in entries %}
          {% assign entry_type = entry.layout | remove: ' ' | downcase %}

          <div class="course-item">
            <h3 class="course-title">{{ entry.title }}</h3>

            <div class="course-meta">
              {% if entry_type == 'course' %}
                <span>Course / Seminar</span>
              {% elsif entry_type == 'workshop' %}
                <span>Workshop</span>
              {% elsif entry_type == 'thesis' %}
                <span>Thesis</span>
              {% endif %}

              {% if entry.program %}
                <span>{{ entry.program }}</span>
              {% endif %}
              {% if entry.term %}
                <span>Term: {{ entry.term }}</span>
              {% endif %}
              {% if entry.location %}
                <span>Location: {{ entry.location }}</span>
              {% endif %}
              {% if entry.instructor %}
                <span>Instructor: {{ entry.instructor }}</span>
              {% endif %}
            </div>

            {% if entry.description %}
              <div class="course-description">
                {{ entry.description | markdownify }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No teaching activities available yet.</p>
{% endif %}