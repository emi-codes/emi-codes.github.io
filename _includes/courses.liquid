{% if site.teachings %}
  <div class="courses">
    {% assign sorted_courses = site.teachings | sort: 'year' | reverse %}

    {% comment %} Group by term and year, e.g. Winter 2025 {% endcomment %}
    {% assign courses_by_term_year = sorted_courses
      | group_by_exp: "course", "course.term | append: ' ' | append: course.year"
    %}

    {% for group in courses_by_term_year %}
      <h2 class="year">{{ group.name }}</h2>

      <div class="course-list">
        {% assign term_courses = group.items | sort: 'title' %}
        {% for course in term_courses %}
          <div class="course-item">
            <h3 class="course-title">{{ course.title }}</h3>

            <div class="course-meta">
              {% if course.program %}
                <span class="course-term">{{ course.program }}</span>
              {% endif %}
              {% if course.location %}
                <span class="course-term">Location: {{ course.location }}</span>
              {% endif %}
              {% if course.instructor %}
                <span class="course-instructor">Instructor: {{ course.instructor }}</span>
              {% endif %}
            </div>

            {% if course.description %}
              <div class="course-description">
                {{ course.description | markdownify }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}