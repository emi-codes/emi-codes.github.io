{% assign section_layouts = "course,workshop,thesis" | split: "," %}

{% for section_layout in section_layouts %}
  {% case section_layout %}
    {% when "course" %}
      {% assign heading = "Courses and Seminars" %}
    {% when "workshop" %}
      {% assign heading = "Workshops" %}
    {% when "thesis" %}
      {% assign heading = "Theses" %}
  {% endcase %}

  {% assign entries = site.teachings | where: "layout", section_layout %}

  {% if entries.size > 0 %}
    <h2>{{ heading }}</h2>
    {% assign entries_by_year = entries | group_by: "year" | sort: "name" | reverse %}

    {% for year_group in entries_by_year %}
      <h3 class="year">{{ year_group.name }}</h3>
      <ul>
        {% for entry in year_group.items %}
          <li>{{ entry.title }}</li>
        {% endfor %}
      </ul>
    {% endfor %}
  {% endif %}
{% endfor %}