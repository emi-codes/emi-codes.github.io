{% if site.teachings %}
  <div class="courses">
    {% assign courses_by_year = site.teachings
      | group_by: 'year'
      | sort: 'name'
      | reverse
    %}

    {% for year_group in courses_by_year %}
      {% assign term_ordered_courses = year_group.items | sort: 'term_order' %}
      {% assign courses_by_term = term_ordered_courses | group_by: 'term' %}

      {% for term_group in courses_by_term %}
        <h3 class="year">{{ term_group.name }} {{ year_group.name }}</h3>

        <div class="">
          {% assign term_courses = term_group.items | sort: 'title' %}

          {% for course in term_courses %}
            <div class="">
              <h4 class="course-title">{{ course.title }}</h4>

              <div class="course-meta">
                {% if course.program %}
                  <i><span class="course-term">Program: {{ course.program }}<br></span></i>
                {% endif %}

                {% if course.location %}
                  <i><span class="course-term">{{ course.location }}<br></span></i>
                {% endif %}

                {% if course.instructor %}
                  <i><span class="course-instructor">Instructor: {{ course.instructor }}</span></i>
                {% endif %}
              </div>

              {% if course.description %}
                <div class="course-description">
                  {{ course.description | markdownify }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}