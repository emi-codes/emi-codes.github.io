{% assign service_items = site.service | sort: "year" | reverse %}

{% if service_items.size > 0 %}
  <ul class="service-list">
    {% for item in service_items %}
      <li>
        {% if item.role %}<strong>{{ item.role }}</strong>{% endif %}
        {% if item.venue %} — {{ item.venue }}{% endif %}
        {% if item.year %} ({{ item.year }}){% endif %}
        {% if item.description %}
          <div>{{ item.description | markdownify }}</div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p>No service activities listed yet.</p>
{% endif %}